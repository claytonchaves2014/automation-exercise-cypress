{
  "name": "automacao-exercicio-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados de API e E2E com Playwright e Cucumber",
  "scripts": {
    "test": "node scripts/run-tests.js all",
    "test:api": "node scripts/run-tests.js api",
    "test:e2e": "node scripts/run-tests.js e2e",
    "test:mobile": "node scripts/run-tests.js mobile",
    "sanitize:reports": "node scripts/sanitize-reports.js",
    "perf:mock": "node performance/mock-api.js",
    "perf:load": "k6 run performance/load.js",
    "perf:smoke": "k6 run -e VUS=5 -e DURATION=10s -e RAMP_DURATION=1s performance/load.js"
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1"
  }
}
